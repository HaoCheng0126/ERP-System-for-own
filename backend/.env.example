NODE_ENV=development
PORT=3001

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=password
DB_DATABASE=kinko

JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# 飞书网页应用登录（可选）
# FEISHU_SCOPE 可按需要配置，未配置时不额外传 scope 参数
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_REDIRECT_URI=
# FEISHU_SCOPE=contact:user.base:readonly

# 生产环境：前端地址，用于 CORS（多个用逗号分隔）
# CORS_ORIGIN=https://yourdomain.com,https://www.yourdomain.com
# FRONTEND_URL=https://yourdomain.com

# 送货单图像识别（可选）：任意 OpenAI 兼容的视觉接口即可，密钥只放这里、不要进代码。
# 推荐 Google Gemini 免费层（AI Studio 申请免费 key，无需信用卡）：
#   VISION_API_KEY=你的_gemini_key
#   VISION_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#   VISION_MODEL=gemini-2.0-flash
# 或通义千问 Qwen-VL（DashScope 兼容模式，国内直连、无需代理，推荐国内部署使用）：
#   VISION_API_KEY=你的_dashscope_key
#   VISION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#   VISION_MODEL=qwen-vl-max
# 不配置时，识别按钮会提示「未配置识别服务」，其余功能不受影响。
#
# 【代理】若使用 Gemini 等海外接口且服务器在中国大陆，需经代理访问。
# npm 启动脚本已加 NODE_USE_ENV_PROXY=1，Node 会自动读取下面的代理变量；
# 请用 `npm start` / `npm run dev` 启动，并设置（按你的代理端口，如 Clash 7890）：
#   HTTPS_PROXY=http://127.0.0.1:7890
#   HTTP_PROXY=http://127.0.0.1:7890
# 改用国内视觉接口（Qwen-VL 等）则无需代理。
VISION_API_KEY=
VISION_BASE_URL=
VISION_MODEL=
